{
  "name": "juntuchat-backend",
  "version": "1.0.0",
  "description": "Backend de Junt'uChat con NestJS, MongoDB y WebSockets",
  "main": "dist/main.js",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neverdead1/juntuChat-backend.git"
  },
  "keywords": ["nestjs", "chat", "mongodb", "websockets"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/neverdead1/juntuChat-backend/issues"
  },
  "homepage": "https://github.com/neverdead1/juntuChat-backend#readme",
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/websockets": "^11.1.9",
    "dotenv": "^17.2.3",
    "mongoose": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.1.9",
    "@nestjs/schematics": "^11.1.9",
    "typescript": "^5.2.2",
    "eslint": "^8.48.0",
    "prettier": "^3.0.0",
    "jest": "^29.6.2",
    "@types/jest": "^29.5.3",
    "ts-jest": "^29.1.1"
  }
}
